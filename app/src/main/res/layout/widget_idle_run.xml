<?xml version="1.0" encoding="utf-8"?>
<!-- IDLE RUN home-screen widget (2 x 3, portrait). Built by widget/IdleRunWidget.kt. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/idle_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_frame_cyan"
    android:padding="7dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header: IDLE RUN + difficulty badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/idle_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-condensed"
                android:maxLines="1"
                android:text="IDLE RUN"
                android:textColor="#FF00E5FF"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/idle_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_badge_standard"
                android:fontFamily="sans-serif-condensed"
                android:paddingLeft="5dp"
                android:paddingTop="1dp"
                android:paddingRight="5dp"
                android:paddingBottom="1dp"
                android:text="STANDARD"
                android:textColor="#FFE6EEFA"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ACTIVE RUN -->
        <LinearLayout
            android:id="@+id/idle_active"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">
            <ViewFlipper
                android:id="@+id/idle_flipper"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_weight="1"
                android:autoStart="true"
                android:background="@drawable/widget_art_bg"
                android:flipInterval="1100">
                <ImageView android:id="@+id/idle_frame_0" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="Operator fighting" />
                <ImageView android:id="@+id/idle_frame_1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="Operator attacking" />
                <ImageView android:id="@+id/idle_frame_2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="Threat hit" />
                <ImageView android:id="@+id/idle_frame_3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="Threat winding up" />
            </ViewFlipper>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginRight="3dp" android:background="@drawable/widget_cell" android:orientation="vertical" android:paddingLeft="5dp" android:paddingTop="2dp" android:paddingBottom="2dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OP LV" android:textColor="#FF93A6C4" android:textSize="8sp" android:textStyle="bold" />
                    <TextView android:id="@+id/idle_op_lv" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-condensed" android:maxLines="1" android:text="1" android:textColor="#FF00E5FF" android:textSize="15sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/widget_cell" android:orientation="vertical" android:paddingLeft="5dp" android:paddingTop="2dp" android:paddingBottom="2dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LEVEL" android:textColor="#FF93A6C4" android:textSize="8sp" android:textStyle="bold" />
                    <TextView android:id="@+id/idle_level" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-condensed" android:maxLines="1" android:text="1" android:textColor="#FFE6EEFA" android:textSize="15sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginRight="3dp" android:background="@drawable/widget_cell" android:orientation="vertical" android:paddingLeft="5dp" android:paddingTop="2dp" android:paddingBottom="2dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="€" android:textColor="#FF93A6C4" android:textSize="8sp" android:textStyle="bold" />
                    <TextView android:id="@+id/idle_euros" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-condensed" android:maxLines="1" android:text="0" android:textColor="#FFFFD426" android:textSize="15sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/widget_cell" android:orientation="vertical" android:paddingLeft="5dp" android:paddingTop="2dp" android:paddingBottom="2dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="XP" android:textColor="#FF93A6C4" android:textSize="8sp" android:textStyle="bold" />
                    <TextView android:id="@+id/idle_xp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-condensed" android:maxLines="1" android:text="0" android:textColor="#FF00E5FF" android:textSize="15sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/idle_strip"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="5dp"
                android:scaleType="fitXY"
                android:contentDescription="Boss progress" />
            <TextView
                android:id="@+id/idle_boss"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-condensed"
                android:maxLines="1"
                android:text="LV 1 · NEXT BOSS 10"
                android:textColor="#FFFF8A1A"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="50% € • 50% XP"
                android:textColor="#FF7FE9F5"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- OPERATOR DEFEATED / RUN COMPLETE -->
        <LinearLayout
            android:id="@+id/idle_ended"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:id="@+id/idle_ended_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-condensed"
                android:maxLines="1"
                android:text="Operator Defeated"
                android:textColor="#FFE6EEFA"
                android:textSize="14sp"
                android:textStyle="bold" />
            <ImageView
                android:id="@+id/idle_ended_art"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="3dp"
                android:layout_weight="1"
                android:background="@drawable/widget_art_bg_red"
                android:scaleType="fitCenter"
                android:contentDescription="Operator defeated" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:text="Highest Level Achieved" android:textColor="#FF93A6C4" android:textSize="9sp" />
                <TextView android:id="@+id/idle_ended_level" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-condensed" android:text="0" android:textColor="#FFE6EEFA" android:textSize="13sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:text="XP Earned" android:textColor="#FF93A6C4" android:textSize="9sp" />
                <TextView android:id="@+id/idle_ended_xp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-condensed" android:text="0" android:textColor="#FF00E5FF" android:textSize="13sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:text="€ Earned" android:textColor="#FF93A6C4" android:textSize="9sp" />
                <TextView android:id="@+id/idle_ended_euros" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-condensed" android:text="0" android:textColor="#FFFFD426" android:textSize="13sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView
                android:id="@+id/idle_ended_cta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/widget_cta"
                android:fontFamily="sans-serif-condensed"
                android:gravity="center"
                android:maxLines="1"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="START NEW IDLE RUN?"
                android:textColor="#FFE6EEFA"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- NO ACTIVE RUN -->
        <LinearLayout
            android:id="@+id/idle_none"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:text="No Active Run"
                android:textColor="#FF93A6C4"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="Your operator fights on its own for 50% € and XP."
                android:textColor="#FF5C6E8C"
                android:textSize="9sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/widget_cta"
                android:fontFamily="sans-serif-condensed"
                android:gravity="center"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="START IDLE RUN"
                android:textColor="#FFE6EEFA"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
